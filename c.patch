+++ b/tests/test_part13_decision_hardening.py
@@ -0,0 +1,71 @@
+"""Regression tests for Part 1.3 decision-engine input hardening."""
+
+import pytest
+from pydantic import ValidationError
+
+from ecofac.decision.limits import ConstraintConfig, CoolingLimits, ElectricalLimits
+from ecofac.decision.measurements import MeasurementSource, RichMeasurement
+from ecofac.decision.transparent import (
+    TransparentDecisionRequest,
+    decide_transparently,
+)
+
+
+def _measurement(name: str, value: float) -> RichMeasurement:
+    return RichMeasurement(
+        name=name,
+        value=value,
+        unit="kW",
+        source=MeasurementSource.MEASURED,
+    )
+
+
+def _request(*, it_delta: float = 0.0, cooling_delta: float = 0.0):
+    return TransparentDecisionRequest(
+        config=ConstraintConfig(
+            electrical=ElectricalLimits(capacity=100, reserve_pct=0.10),
+            cooling=CoolingLimits(capacity=100, reserve_pct=0.10),
+        ),
+        config_version="test-v1",
+        it_load=_measurement("it_load", 20),
+        cooling_load=_measurement("cooling_load", 20),
+        proposed_it_delta=it_delta,
+        proposed_cooling_delta=cooling_delta,
+        quality_eligible=True,
+    )
+
+
+@pytest.mark.parametrize(
+    ("it_delta", "cooling_delta", "expected_flag"),
+    [
+        (-21.0, 0.0, "negative_projected_it_load"),
+        (0.0, -21.0, "negative_projected_cooling_load"),
+    ],
+)
+def test_negative_projected_load_forces_review(
+    it_delta: float,
+    cooling_delta: float,
+    expected_flag: str,
+) -> None:
+    result = decide_transparently(
+        _request(it_delta=it_delta, cooling_delta=cooling_delta)
+    )
+    assert result.status == "REVIEW"
+    assert any(expected_flag in item for item in result.state_machine_decision.unresolved_conditions)
+
+
+def test_nan_measurement_is_rejected() -> None:
+    with pytest.raises(ValidationError):
+        _measurement("it_load", float("nan"))
+
+
+@pytest.mark.parametrize("bad_value", [float("nan"), float("inf"), float("-inf")])
+def test_non_finite_proposed_delta_is_rejected(bad_value: float) -> None:
+    with pytest.raises(ValidationError):
+        _request(it_delta=bad_value)
+
+
+@pytest.mark.parametrize("bad_capacity", [float("nan"), float("inf")])
+def test_non_finite_capacity_is_rejected(bad_capacity: float) -> None:
+    with pytest.raises(ValidationError):
+        ElectricalLimits(capacity=bad_capacity, reserve_pct=0.10)
